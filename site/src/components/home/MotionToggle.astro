---
/**
 * “暂停动画”开关（WCAG 2.2.2）：停掉扫描线、数据包流动、热点脉冲和演示视频，选择存在 localStorage。
 * 行为在 scripts/motion.ts 的 initToggles；没有 JS 或开启了减少动态效果时没有可暂停的东西，按钮隐藏。
 */
import "../../styles/home.css";

interface Props {
  label: string;
  /** 已暂停时的可见文字 */
  pressedLabel: string;
}

const { label, pressedLabel } = Astro.props;
---

<div class="emu-motion-toggle not-content">
  <button
    type="button"
    data-motion-toggle
    data-label={label}
    data-pressed-label={pressedLabel}
    aria-pressed="false"
  >
    <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true">
      <rect x="4" y="3" width="2.5" height="10" rx="0.5"></rect>
      <rect x="9.5" y="3" width="2.5" height="10" rx="0.5"></rect>
    </svg>
    <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M5 3l8 5-8 5z"></path>
    </svg>
    <span data-motion-text>{label}</span>
  </button>
</div>

<style>
  /* 首页右上角的小开关；relative + z-index：首屏的光晕在它下面，不抬层级会点不到 */
  .emu-motion-toggle {
    position: relative;
    z-index: 1;
    display: none;
    justify-content: flex-end;
  }

  :global(.emu-motion) .emu-motion-toggle {
    display: flex;
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2rem;
    padding-inline: 0.75rem;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--emu-muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  button:hover {
    color: var(--emu-text);
    background: var(--emu-surface);
  }

  button:focus-visible {
    outline: 2px solid var(--emu-accent);
    outline-offset: 2px;
  }

  button[aria-pressed="true"] {
    color: var(--emu-text);
    background: var(--emu-surface);
  }

  svg {
    inline-size: 0.8rem;
    block-size: 0.8rem;
    fill: currentColor;
  }

  button[aria-pressed="true"] svg {
    color: var(--emu-accent);
  }

  .icon-play,
  button[aria-pressed="true"] .icon-pause {
    display: none;
  }

  button[aria-pressed="true"] .icon-play {
    display: block;
  }
</style>
